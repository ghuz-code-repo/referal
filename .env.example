# Пример конфигурации для Referal Service
# Скопируйте этот файл в .env и заполните своими значениями

# ===========================================
# Notification Service Configuration
# ===========================================
# URL notification service для отправки email уведомлений
NOTIFICATION_SERVICE_URL=http://notification-service:8082

# Таймаут запросов к notification service (в секундах)
NOTIFICATION_SERVICE_TIMEOUT=30

# ===========================================
# Database Configuration
# ===========================================
# PostgreSQL Configuration (recommended for production)
POSTGRES_DB=referal_db
POSTGRES_USER=referal_user
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy Database URI (will be constructed from above)
# Format: postgresql://user:password@host:port/database
SQLALCHEMY_DATABASE_URI=postgresql://referal_user:your-strong-password-here@postgres:5432/referal_db

# Legacy SQLite (for development only)
# SQLALCHEMY_DATABASE_URI=sqlite:///referal.db

# ===========================================
# Flask Configuration
# ===========================================
SECRET_KEY=your-secret-key-here
BEHIND_PROXY=true

# ===========================================
# Email Configuration (для уведомлений админам)
# ===========================================
# Email администратора для получения уведомлений
MAIN_ADMIN_EMAIL=admin@example.com

# Email менеджера call-центра
CALL_CENTER_MANAGER_EMAIL=callcenter@example.com

# ===========================================
# SMS Configuration (опционально)
# ===========================================
SMS_API_URL=https://api.playmobile.uz/v1/send
SMS_API_USERNAME=your-username
SMS_API_PASSWORD=your-password
SMS_API_ORIGINATOR=YourCompany
GH_PHONE_NUMBER=+998901234567

# ===========================================
# Referal Configuration
# ===========================================
# Порог проверки истории взаимодействий с CRM (в днях)
# Клиент не может быть добавлен как реферал, если взаимодействовал с CRM в пределах этого срока
REFERAL_DAYS_THRESHOLD=45

# ===========================================
# Auth Connector Configuration
# ===========================================
# URL auth-service для интеграции
AUTH_SERVICE_URL=http://auth-service:8080

# ===========================================
# MySQL Configuration (для интеграции с внешней БД)
# ===========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=your-database

# ===========================================
# LEGACY: Старые настройки SMTP (больше не используются)
# ===========================================
# Эти настройки оставлены для справки, но больше не используются
# Все email отправляются через Notification Service
# EMAIL_SERVER=smtp.gmail.com
# EMAIL_SERVER_PORT=587
# SEND_FROM_EMAIL=noreply@example.com
# SEND_FROM_EMAIL_PASSWORD=your-app-password
