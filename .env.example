# Referal Service Environment
# Copy this file to .env: cp .env.example .env

# Server configuration
SERVER_NAME=localhost

# Auth service configuration
AUTH_SERVICE_URL=http://auth-service:80
# NOTE: Must be identical to JWT_SECRET in auth-service and client_service!
JWT_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48"
# NOTE: Must be identical to INTERNAL_API_KEY in auth-service!
INTERNAL_API_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

DB_FETCH_MAX_WORKERS=15
DB_FETCH_CONTACTS_BATCH_SIZE=10000
DB_FETCH_DEALS_BATCH_SIZE=3000
# Whether the app is running behind a proxy that adds /referal prefix
BEHIND_PROXY=true

ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME_RANDOM_STRING

# Database Configuration
# PostgreSQL (Production)
POSTGRES_DB=referal_db
POSTGRES_USER=referal_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
SQLALCHEMY_DATABASE_URI=postgresql://referal_user:CHANGE_ME@postgres:5432/referal_db

# Remote MySQL (MacroCRM source)
MYSQL_HOST=CHANGE_ME
MYSQL_PORT=9906
MYSQL_DATABASE=CHANGE_ME
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

# Email settings
SEND_FROM_EMAIL=robot@example.com
SEND_FROM_EMAIL_PASSWORD=CHANGE_ME
EMAIL_SERVER=mail.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_IP=CHANGE_ME
MAIN_ADMIN_EMAIL=admin@example.com
PAYMENT_MANAGER_EMAIL=CHANGE_ME
CALL_CENTER_MANAGER_EMAIL=CHANGE_ME
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=80
PYTHONUNBUFFERED=1
GH_PHONE_NUMBER=CHANGE_ME

# SMS API
SMS_API_URL=https://send.smsxabar.uz/broker-api/send
SMS_API_USERNAME=CHANGE_ME
SMS_API_PASSWORD=CHANGE_ME
SMS_API_ORIGINATOR=CHANGE_ME

# MacroCRM integration
MACRO_TASK_HOUR=15
MACRO_SECRET=CHANGE_ME
MACRO_DOMAIN=http://gh.uz
MACRO_TASK_API_URL=https://api.macrocrm.gh.uz/estate/request/
MACRO_JWT_TOKEN=0
MACRO_APP_ID=0

# Referal withdrawal thresholds (in UZS)
REFERAL_WITHDRAWAL_FOR_40M=3000000
REFERAL_WITHDRAWAL_FOR_60M=5000000
REFERAL_WITHDRAWAL_FOR_80M=7000000
REFERAL_WITHDRAWAL_FOR_81M=10000000
NDS_PERCENT=12
NDS_ROUNDING_ADJUSTMENT=1
TRASHHOLDDAYS=45
ACT_DOC_NAME=Акт_об_оказании_услуг_для_сотрудников_GH
AGREEMENT_DOC_NAME=Соглашение_об_участии_в_Реферальной_программе_для_сотрудников_GH
